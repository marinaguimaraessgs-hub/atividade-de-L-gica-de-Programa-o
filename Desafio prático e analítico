# ============================================================
# QUESTÃO 8
# Receber números ou palavras, armazenar em listas diferentes
# e encerrar quando o usuário digitar x ou X.
# ============================================================

palavras = []
numeros = []

while True:
    entrada = input("Digite um número ou uma palavra (x para sair): ")

    if entrada.lower() == 'x':
        break

    if entrada.isdigit():
        numeros.append(entrada)
    else:
        palavras.append(entrada)

print("Palavras:", palavras)
print("Números:", numeros)

total = len(palavras) + len(numeros)

print("Quantidade total de coisas digitadas:", total)
