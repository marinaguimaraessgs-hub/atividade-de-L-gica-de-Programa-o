'''
2. Escolha de bolas ao acaso:
a) Contar quantas bolas existem na caixa
b) Contar quantas são vermelhas
c) Calcular a probabilidade de escolher uma bola vermelha
d) Apresentar a probabilidade em fração e porcentagem
'''
print("=== QUESTÃO 2 ===")
bolas = ["vermelha", "azul", "verde", "vermelha", "amarela", "azul", "vermelha", "verde", "azul", "vermelha"]

total_bolas = len(bolas)
bolas_vermelhas = bolas.count("vermelha")
probabilidade = bolas_vermelhas / total_bolas

fracao_prob = Fraction(bolas_vermelhas, total_bolas)
porcentagem_prob = probabilidade * 100

print(f"a) Total de bolas na caixa: {total_bolas}")
print(f"b) Total de bolas vermelhas: {bolas_vermelhas}")
print(f"c) Probabilidade de escolher vermelha: {probabilidade:.2f}")
print(f"d) Probabilidade em fração: {fracao_prob} | Probabilidade em porcentagem: {porcentagem_prob:.1f}%\n")


# ------------------------------------------
# QUESTÃO 3
# ------------------------------------------
'''
3. Relatório do boletim dos alunos
'''
print("=== QUESTÃO 3 ===")
alunos = [
    ["Ana", 7.5, 8.0, 9.0],
    ["Bruno", 6.0, 5.5, 7.0],
    ["Carlos", 9.0, 8.5, 10.0],
    ["Daniela", 5.0, 6.0, 4.5],
    ["Eduardo", 8.0, 7.5, 6.5]
]

medias_alunos = []
aprovados = 0
reprovados = 0

print("--- Relatório de Alunos ---")
for aluno in alunos:
    nome = aluno[0]
    media = sum(aluno[1:]) / 3
    medias_alunos.append((nome, media))
    
    if media >= 7.0:
        status = "Aprovado"
        aprovados += 1
    else:
        status = "Reprovado"
        reprovados += 1
        
    # Exibe a) Nome, b) Média, c) Status de aprovação
    print(f"Aluno: {nome:<10} | Média: {media:.2f} | Status: {status}")

# d) Média geral da turma
media_geral = sum(m[1] for m in medias_alunos) / len(medias_alunos)

# e) Nome do aluno com a maior média
aluno_maior_media = max(medias_alunos, key=lambda x: x[1])[0]

# f) Nome do aluno com a menor média
aluno_menor_media = min(medias_alunos, key=lambda x: x[1])[0]

print("\n--- Estatísticas da Turma ---")
print(f"d) Média geral da turma: {media_geral:.2f}")
print(f"e) Aluno com maior média: {aluno_maior_media}")
print(f"f) Aluno com menor média: {aluno_menor_media}")
print(f"g) Quantidade de aprovados: {aprovados}")
print(f"h) Quantidade de reprovados: {reprovados}\n")


