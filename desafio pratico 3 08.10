'''
4. Reescrita do código de acréscimo de 10% utilizando List Comprehension
'''
print("=== QUESTÃO 4 ===")
precos = [50, 80, 120, 35, 200, 75]

# List Comprehension para aplicar 10% de acréscimo
novos_precos = [preco * 1.10 for preco in precos]

print(f"Novos preços (com List Comprehension): {novos_precos}\n")


# ------------------------------------------
# QUESTÃO 5
# ------------------------------------------
'''
5. Cálculo de valor do estacionamento com base na permanência
'''
print("=== QUESTÃO 5 ===")

def calcular_estacionamento(horas):
    if horas <= 1:
        return 5.00
    elif horas <= 3:
        return 10.00
    elif horas <= 5:
        return 15.00
    else:
        return 20.00

# Código principal
horas_permanencia = float(input("Digite o tempo de permanência no estacionamento (em horas): "))
valor_pagar = calcular_estacionamento(horas_permanencia)
print(f"Valor a ser pago: R$ {valor_pagar:.2f}\n")


# ------------------------------------------
# QUESTÃO 6
# ------------------------------------------
'''
6. Função para calcular idade e verificar se é maior de idade (com Desafio)
'''
print("=== QUESTÃO 6 ===")

def calcular_idade(ano_nascimento, ano_atual):
    idade = ano_atual - ano_nascimento
    
    # Desafio: verificar se é maior ou menor de idade
    if idade >= 18:
        classificacao = "Maior de idade"
    else:
        classificacao = "Menor de idade"
        
    return idade, classificacao

# Código principal
ano_nasc = int(input("Digite o ano de nascimento: "))
ano_atual = datetime.now().year

idade, status_idade = calcular_idade(ano_nasc, ano_atual)
print(f"Idade: {idade} anos | Status: {status_idade}\n")


# ------------------------------------------
# QUESTÃO 7
# ------------------------------------------
'''
7. Funções para área de figuras geométricas (Triângulo, Trapézio, Losango)
'''
print("=== QUESTÃO 7 ===")

def area_triangulo(base, altura):
    return (base * altura) / 2

def area_trapezio(base_maior, base_menor, altura):
    return ((base_maior + base_menor) * altura) / 2

def area_losango(diagonal_maior, diagonal_menor):
    return (diagonal_maior * diagonal_menor) / 2

# Exemplos de uso das funções
print(f"Área do Triângulo (base 10, altura 5): {area_triangulo(10, 5)}")
print(f"Área do Trapézio (base maior 10, base menor 6, altura 4): {area_trapezio(10, 6, 4)}")
print(f"Área do Losango (diagonal maior 8, diagonal menor 6): {area_losango(8, 6)}\n")


# ------------------------------------------
# QUESTÃO 8
# ------------------------------------------
'''
8. Validação de senha: mínimo 8 caracteres e pelo menos um número (com Desafio)
'''
print("=== QUESTÃO 8 ===")

def validar_senha(senha):
    # Regra principal: pelo menos 8 caracteres
    tem_tamanho_minimo = len(senha) >= 8
    
    # Desafio: conter pelo menos um número
    tem_numero = any(char.isdigit() for char in senha)
    
    return tem_tamanho_minimo and tem_numero

# Teste com input
senha_usuario = input("Digite a senha para validação: ")
if validar_senha(senha_usuario):
    print("Senha VÁLIDA (Atende a todos os critérios)!")
else:
    print("Senha INVÁLIDA (Precisa ter no mínimo 8 caracteres e conter pelo menos um número).")
