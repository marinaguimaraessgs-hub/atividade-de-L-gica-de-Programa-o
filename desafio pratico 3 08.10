# ------------------------------------------
# QUESTÃO 1
# ------------------------------------------
'''
1. Programa que recebe 10 idades e calcula:
a) Média das idades
b) Mediana
c) Moda
'''
print("=== QUESTÃO 1 ===")
idades = []
for i in range(1, 11):
    idade = int(input(f"Digite a {i}ª idade: "))
    idades.append(idade)

media_idades = statistics.mean(idades)
mediana_idades = statistics.median(idades)
# statistics.multimode é utilizado para tratar caso haja mais de uma moda
moda_idades = statistics.multimode(idades) 

print(f"a) Média das idades: {media_idades:.2f}")
print(f"b) Mediana das idades: {mediana_idades:.2f}")
print(f"c) Moda das idades: {moda_idades}\n")


