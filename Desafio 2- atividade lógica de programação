    populacao = populacao * 1.04

    print("População ao final do ano", ano, ":", populacao)

    ano = ano + 1


# ============================================================
# QUESTÃO 6 - PROBABILIDADE EXPERIMENTAL
# ============================================================
# O dado é lançado 20 vezes.
# O programa recebe o resultado de cada lançamento e conta
# quantas vezes apareceu um número par.
#
# Os números pares de um dado são:
# 2, 4 e 6.
#
# Ao final, calcula:
# probabilidade = quantidade de pares / quantidade de lançamentos

print("\nQUESTÃO 6")

quantidade_pares = 0
lancamento = 1

while lancamento <= 20:

    resultado = int(input(
        "Digite o resultado do lançamento " + str(lancamento) + ": "
    ))

    # Verifica se o resultado pertence a um dado
    if resultado >= 1 and resultado <= 6:

        # Verifica se o resultado é par
        if resultado % 2 == 0:
            quantidade_pares = quantidade_pares + 1

        lancamento = lancamento + 1

    else:
        # Se for inválido, não conta o lançamento
        # e pede novamente.
        print("Resultado inválido! Digite um número de 1 a 6.")

# Calcula a probabilidade experimental
probabilidade = quantidade_pares / 20

print("Quantidade de números pares:", quantidade_pares)
print("Probabilidade experimental:", probabilidade)
print("Probabilidade em porcentagem:", probabilidade * 100, "%")
